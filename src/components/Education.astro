---
import { getContent, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { education, nav } = getContent(lang);
const label = nav.find((l) => l.href === "#educacion")?.label ?? "Educación";
---

<section id="educacion" class="max-w-5xl mx-auto px-6 sm:px-8 py-24 border-t border-[var(--color-border)]">
  <div class="grid sm:grid-cols-[200px_1fr] gap-8 sm:gap-16">
    <div class="flex items-center gap-2 h-fit">
      <span class="w-2 h-2 rounded-full bg-[var(--color-accent)]" />
      <h2 class="text-sm text-[var(--color-ink)] font-medium">{label}</h2>
    </div>
    <div class="flex flex-col gap-12 max-w-2xl">
      {
        education.map((item) => (
          <div class="grid sm:grid-cols-[140px_1fr] gap-2 sm:gap-8">
            <span class="text-sm text-[var(--color-accent-warm)] font-medium">
              {item.period}
            </span>
            <div>
              <h3 class="text-lg font-medium mb-1 text-[var(--color-ink)]">
                {item.degree}{" "}
                <span class="text-[var(--color-ink-muted)] font-normal">
                  · {item.institution}
                </span>
              </h3>
              {item.description && (
                <p class="text-[var(--color-ink-muted)] leading-relaxed">
                  {item.description}
                </p>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
