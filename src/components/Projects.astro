---
import { getContent, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { projects, nav } = getContent(lang);
const label = nav.find((l) => l.href === "#proyectos")?.label ?? "Proyectos";
---

<section id="proyectos" class="max-w-5xl mx-auto px-6 sm:px-8 py-24 border-t border-[var(--color-border)]">
  <div class="grid sm:grid-cols-[200px_1fr] gap-8 sm:gap-16">
    <div class="flex items-center gap-2 h-fit">
      <span class="w-2 h-2 rounded-full bg-[var(--color-accent)]" />
      <h2 class="text-sm text-[var(--color-ink)] font-medium">{label}</h2>
    </div>
    <div class="flex flex-col gap-16 max-w-2xl">
      {
        projects.map((project) => (
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="group block border-l-2 border-[var(--color-border)] hover:border-[var(--color-accent)] pl-6 -ml-px transition-colors"
          >
            <h3 class="text-2xl font-medium tracking-tight mb-2 text-[var(--color-ink)] group-hover:text-[var(--color-accent)] transition-colors">
              {project.title}
            </h3>
            <p class="text-[var(--color-ink-muted)] leading-relaxed mb-4">
              {project.description}
            </p>
            <div class="flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="text-xs text-[var(--color-accent)] bg-[var(--color-accent-soft)] rounded-full px-3 py-1">
                  {tag}
                </span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
