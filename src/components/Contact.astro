---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { getContent, type Lang } from "../i18n/content";
import { socialIcon } from "./icons/social";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { contact, profile } = getContent(lang);
const madeWith =
  lang === "es" ? "Hecho con Astro + Tailwind." : "Made with Astro + Tailwind.";
---

<section
  id="contacto"
  class="max-w-5xl mx-auto px-6 sm:px-8 py-32 border-t border-[var(--color-border)]"
>
  <div class="max-w-xl">
    <h2
      data-reveal
      class="text-4xl sm:text-5xl font-medium tracking-tight mb-6 text-[var(--color-ink)]"
    >
      {contact.heading}
    </h2>
    <p
      data-reveal
      class="text-lg text-[var(--color-ink-muted)] leading-relaxed mb-10"
    >
      {contact.text}
    </p>
    <div class="flex flex-wrap gap-3">
      {contact.socials.map((s, i) => {
        const Icon = socialIcon(s.label);
        const external = s.href.startsWith("http");
        return (
          <a
            data-reveal
            href={s.href}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener noreferrer" : undefined}
            class={`group inline-flex items-center gap-2 text-sm font-medium rounded-full pl-4 pr-3.5 py-2 transition-colors ${
              i === 0
                ? "bg-[var(--color-accent)] text-white hover:bg-[var(--color-accent-strong)]"
                : "bg-[var(--color-accent-warm-soft)] text-[var(--color-accent-warm)] hover:bg-[var(--color-accent-warm)] hover:text-white"
            }`}
          >
            <Icon size={16} />
            {s.label}
            {external && (
              <ArrowUpRight
                size={14}
                class="opacity-60 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transition-none"
                aria-hidden="true"
              />
            )}
          </a>
        );
      })}
    </div>
  </div>
</section>

<footer class="max-w-5xl mx-auto px-6 sm:px-8 pb-10">
  <p class="text-sm text-[var(--color-ink-muted)]">
    © {new Date().getFullYear()} {profile.name}. {madeWith}
  </p>
</footer>
