---
import Languages from "@lucide/astro/icons/languages";
import Mail from "@lucide/astro/icons/mail";
import { getContent, langPaths, languages, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { nav: links, profile } = getContent(lang);
const otherLang: Lang = lang === "es" ? "en" : "es";
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-[var(--color-bg)]/85 backdrop-blur-sm border-b border-[var(--color-border)]">
  <div class="max-w-5xl mx-auto px-6 sm:px-8 py-5 flex items-center justify-between">
    <a
      href={langPaths[lang]}
      class="text-sm font-medium tracking-tight text-[var(--color-ink)]"
    >
      {profile.name}
    </a>
    <ul class="hidden sm:flex items-center gap-8">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-sm text-[var(--color-ink-muted)] hover:text-[var(--color-accent)] transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="flex items-center gap-4">
      <a
        href={langPaths[otherLang]}
        class="flex items-center gap-1.5 text-sm text-[var(--color-ink-muted)] hover:text-[var(--color-accent)] transition-colors"
        aria-label={`Switch to ${languages[otherLang]}`}
      >
        <Languages size={16} aria-hidden="true" />
        {otherLang.toUpperCase()}
      </a>
      <a
        href="#contacto"
        class="flex items-center gap-1.5 text-sm font-medium bg-[var(--color-accent)] text-white rounded-full px-4 py-1.5 hover:bg-[var(--color-accent-strong)] transition-colors"
      >
        <Mail size={14} aria-hidden="true" />
        {lang === "es" ? "Contacto" : "Contact"}
      </a>
    </div>
  </div>
  <div
    data-progress
    aria-hidden="true"
    class="absolute bottom-[-1px] left-0 h-px w-full bg-[var(--color-accent)]"
    style="transform: scaleX(0); transform-origin: left center;"
  ></div>
</nav>
