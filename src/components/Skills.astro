---
import Wrench from "@lucide/astro/icons/wrench";
import Code from "@lucide/astro/icons/code";
import LayoutDashboard from "@lucide/astro/icons/layout-dashboard";
import Server from "@lucide/astro/icons/server";
import Database from "@lucide/astro/icons/database";
import Boxes from "@lucide/astro/icons/boxes";
import { getContent, type Lang } from "../i18n/content";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { skills: skillGroups, nav } = getContent(lang);
const label = nav.find((l) => l.href === "#skills")?.label ?? "Skills";

const categoryIcons = [Code, LayoutDashboard, Server, Database, Boxes];
---

<section
  id="skills"
  class="max-w-5xl mx-auto px-6 sm:px-8 py-24 border-t border-[var(--color-border)]"
>
  <div class="grid sm:grid-cols-[200px_1fr] gap-8 sm:gap-16">
    <SectionHeading label={label} icon={Wrench} />
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-10 max-w-2xl">
      {skillGroups.map((group, i) => {
        const Icon = categoryIcons[i] ?? Code;
        return (
          <div data-reveal>
            <h3 class="flex items-center gap-2 text-sm font-medium mb-4 text-[var(--color-accent-warm)]">
              <Icon size={16} aria-hidden="true" />
              {group.category}
            </h3>
            <ul class="flex flex-col gap-2">
              {group.items.map((item) => (
                <li class="text-[var(--color-ink)]/80">{item}</li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </div>
</section>
